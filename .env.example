#  Hugging Face (Required for pulling gated models like Llama-3 or pushing LoRA adapters)
HF_TOKEN=your_huggingface_read_write_token_here

# Local LLM Server (Ollama / vLLM API routing)
# Note: For local Ollama, the token can just be "local-mode"
OPENAI_API_KEY=local-mode
OPENAI_BASE_URL=http://localhost:11434/v1

# Experiment Tracking (MLflow settings for Phase 2 fine-tuning)
MLFLOW_TRACKING_URI=http://127.0.0.1:5000